# ---------------------------------------------------------------------------
# Vivado build output
#
# Everything Vivado generates is reproducible from the checked-in sources and
# must never enter git. The upstream .gitignore missed most of this, which is
# how ~279 MB of untracked project output accumulated in a working tree.
# ---------------------------------------------------------------------------

# Project directories created by create_project / the build scripts
*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.srcs/
*.xpr
ip_user_files/
.Xil/
.jobs/

# Block-design output. Every BD here is generated by sourcing its own tcl, so
# an elaborated bd/ tree is build output, not source.
designs/*/bd/

# Per-project output directories (upstream convention)
vivado_*
output_*

# Vivado logs, journals and scratch
*.jou
*.log
*.str
*.wdf
*.backup.jou
*.backup.log
vivado_pid*.str
hs_err_pid*.log

# Generated sources
defines.v

# Build artifacts. Bitstreams and flash images are shipped via GitHub Releases,
# never committed. NOTE: .ltx is deliberately NOT ignored -- it is small and
# Hardware Manager needs it to resolve ILA/IBERT debug probes.
*.bit
*.bin
*.mcs
*.prm
*.mif
*.dcp
*.xsa

# Host-side build output
*.o
*.ko
*.mod
*.mod.c
*.symvers
*.order
.*.cmd
compile/bin/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Editor / OS
*~
*.swp
.DS_Store
